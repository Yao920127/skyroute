# 複製為 .env 後填入實際值（.env 已列入 .gitignore，請勿提交）
# 伺服器預設 Duffel 金鑰（選填）：留空時使用者必須在網頁右上角「API 金鑰」輸入自己的金鑰
DUFFEL_ACCESS_TOKEN=duffel_test_xxx
# 加密保存使用者金鑰（供背景巡檢）；用 python -c "import secrets;print(secrets.token_urlsafe(32))" 產生
# 更換後，先前保存的使用者金鑰將無法解密，相關追蹤的巡檢會失敗直到使用者重新建立
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://localhost:5432/skyroute
# 留空則使用行程內記憶體快取（僅適合單機開發）
# REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
DUFFEL_SUPPLIER_TIMEOUT_MS=10000
OUTBOUND_RATE_PER_S=0.4
OUTBOUND_BURST=4
MATRIX_CONCURRENCY=6
PATROL_DAILY_AT=03:00
PATROL_TIMEZONE=Asia/Taipei
PATROL_RUN_ON_START=false
ALERT_COOLDOWN_HOURS=24
# Google 登入（選填）：設定 OAuth 用戶端 ID 後啟用，看盤清單與金鑰改為依帳號分開；需同時設定 SECRET_KEY
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# 本機以 http://localhost 開發時設為 false；正式環境（HTTPS）保持 true
# SESSION_COOKIE_SECURE=false
# 設定後 POST /api/patrol/run 需帶 X-Admin-Token
# ADMIN_TOKEN=
