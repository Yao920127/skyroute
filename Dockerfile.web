# syntax=docker/dockerfile:1

# ---------- build：Vite+ 官方工具鏈映像 ----------
FROM ghcr.io/voidzero-dev/vite-plus:latest AS build
WORKDIR /app
COPY --chown=vp:vp package.json bun.lock ./
RUN vp install --frozen-lockfile
COPY --chown=vp:vp index.html tsconfig.json vite.config.ts ./
COPY --chown=vp:vp public ./public
COPY --chown=vp:vp src ./src
RUN vp build

# ---------- runtime：Nginx 提供靜態資產並反向代理 /api ----------
FROM nginx:1.27-alpine AS runtime
# 官方映像啟動時會用 envsubst 把 templates/*.template 展開到 conf.d（只替換已定義的環境變數）
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
# 本機 docker compose 用預設值；Railway 會注入 PORT，並以 API_UPSTREAM 指向 api 的私有網域
ENV PORT=80 API_UPSTREAM=api:8000 REAL_IP_FROM=127.0.0.1 NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
EXPOSE 80
